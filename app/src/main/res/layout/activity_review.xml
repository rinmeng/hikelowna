<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/darkslategrey"
    tools:context=".ReviewActivity">

    <TextView
        android:id="@+id/reviewText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:fontFamily="@font/nexaheavy"
        android:text="Hike Review"
        android:textColor="@color/gainsboro"
        android:textSize="40sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/nexaheavy"
        android:text="Title"
        android:textColor="@color/gainsboro"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="@+id/trailNameText"
        app:layout_constraintTop_toBottomOf="@+id/trailDescriptionText" />

    <TextView
        android:id="@+id/charLimitText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:fontFamily="@font/nexaheavy"
        android:text="(max 35)"
        android:textColor="@color/gray"
        app:layout_constraintBottom_toBottomOf="@+id/titleText"
        app:layout_constraintStart_toEndOf="@+id/titleText"
        app:layout_constraintTop_toTopOf="@+id/titleText" />

    <TextView
        android:id="@+id/trailText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/nexaheavy"
        android:text="Trail"
        android:textColor="@color/gainsboro"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.101"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/reviewText" />

    <TextView
        android:id="@+id/trailNameText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/nexalight"
        android:text="Trail Name"
        android:textColor="@color/gainsboro"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="@+id/trailText"
        app:layout_constraintTop_toBottomOf="@+id/trailText" />

    <TextView
        android:id="@+id/trailDescriptionText"
        android:layout_width="325dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/nexalight"
        android:text="Trail Description"
        android:textColor="@color/gainsboro"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="@+id/trailNameText"
        app:layout_constraintTop_toBottomOf="@+id/trailNameText" />

    <Button
        android:id="@+id/postButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="88dp"
        android:layout_marginBottom="40dp"
        android:fontFamily="@font/nexaheavy"
        android:text="Post →"
        android:textColor="@color/gainsboro"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/backButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="40dp"
        android:fontFamily="@font/nexaheavy"
        android:text="← Back"
        android:textColor="@color/gainsboro"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/postButton" />

    <EditText
        android:id="@+id/titleInput"
        android:layout_width="325dp"
        android:layout_height="wrap_content"
        android:ems="10"
        android:fontFamily="@font/nexalight"
        android:hint="e.g. My favourite hike..."
        android:inputType="text"
        android:maxLength="35"
        android:textColor="@color/gainsboro"
        android:textColorHint="@color/silver"
        app:layout_constraintStart_toStartOf="@+id/titleText"
        app:layout_constraintTop_toBottomOf="@+id/titleText" />

    <EditText
        android:id="@+id/descriptionInput"
        android:layout_width="325dp"
        android:layout_height="wrap_content"
        android:ems="10"
        android:fontFamily="@font/nexalight"
        android:hint="e.g. I went with my friends and we had a great time..."
        android:inputType="textMultiLine"
        android:maxLength="100"
        android:textColor="@color/gainsboro"
        android:textColorHint="@color/silver"
        app:layout_constraintStart_toStartOf="@+id/descriptionText"
        app:layout_constraintTop_toBottomOf="@+id/descriptionText" />

    <TextView
        android:id="@+id/charLimitText2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:fontFamily="@font/nexaheavy"
        android:text="(max 100)"
        android:textColor="@color/gray"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="@+id/descriptionText"
        app:layout_constraintStart_toEndOf="@+id/descriptionText"
        app:layout_constraintTop_toTopOf="@+id/descriptionText" />


    <TextView
        android:id="@+id/descriptionText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/nexaheavy"
        android:text="Description"
        android:textColor="@color/gainsboro"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="@+id/titleInput"
        app:layout_constraintTop_toBottomOf="@+id/titleInput" />


    <TextView
        android:id="@+id/ratingText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/nexaheavy"
        android:text="Rating"
        android:textColor="@color/gainsboro"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="@+id/descriptionInput"
        app:layout_constraintTop_toBottomOf="@+id/descriptionInput" />

    <TextView
        android:id="@+id/charLimitText3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:fontFamily="@font/nexaheavy"
        android:text="(👎 → 👍)"
        android:textColor="@color/gray"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="@+id/ratingText"
        app:layout_constraintStart_toEndOf="@+id/ratingText"
        app:layout_constraintTop_toTopOf="@+id/ratingText" />

    <RadioGroup
        android:id="@+id/ratingRadioGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="@+id/ratingText"
        app:layout_constraintTop_toBottomOf="@+id/ratingText">

        <RadioButton
            android:id="@+id/rating1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:fontFamily="@font/nexaheavy"
            android:paddingHorizontal="10dp"
            android:text="1"
            android:textColor="@color/gainsboro" />

        <RadioButton
            android:id="@+id/rating2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nexaheavy"
            android:paddingHorizontal="10dp"
            android:text="2"
            android:textColor="@color/gainsboro" />

        <RadioButton
            android:id="@+id/rating3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nexaheavy"
            android:paddingHorizontal="10dp"
            android:text="3"
            android:textColor="@color/gainsboro" />

        <RadioButton
            android:id="@+id/rating4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nexaheavy"
            android:paddingHorizontal="10dp"
            android:text="4"
            android:textColor="@color/gainsboro" />

        <RadioButton
            android:id="@+id/rating5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nexaheavy"
            android:paddingHorizontal="10dp"
            android:text="5"
            android:textColor="@color/gainsboro" />
    </RadioGroup>


    <TextView
        android:id="@+id/saveText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/nexaheavy"
        android:text="Save"
        android:textColor="@color/gainsboro"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="@+id/ratingRadioGroup"
        app:layout_constraintTop_toBottomOf="@+id/ratingRadioGroup" />

    <RadioGroup
        android:id="@+id/saveRadioGroup"
        android:layout_width="300dp"
        android:layout_height="100dp"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="@+id/saveText"
        app:layout_constraintTop_toBottomOf="@+id/saveText">

        <RadioButton
            android:id="@+id/saveToHistoryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:fontFamily="@font/nexaheavy"
            android:paddingHorizontal="10dp"
            android:text="Save to History Only"
            android:textColor="@color/gainsboro" />

        <RadioButton
            android:id="@+id/saveToHistoryAndPostButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nexaheavy"
            android:paddingHorizontal="10dp"
            android:text="Save to History &amp; Post to Feed + Hike Reviews"
            android:textColor="@color/gainsboro" />
    </RadioGroup>


</androidx.constraintlayout.widget.ConstraintLayout>